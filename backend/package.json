{
  "name": "junior-school-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:shared && tsx watch src/server.ts",
    "build:shared": "tsc -p ../shared/tsconfig.json",
    "build": "npm run build:shared && tsc",
    "start": "node dist/server.js",
    "calc:install": "python -m pip install -r python_calc/requirements.txt",
    "calc:dev": "python -m uvicorn python_calc.app:app --host 127.0.0.1 --port 8100",
    "hash-password": "node scripts/hash-password.mjs",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "seed:permissions": "tsx scripts/seed-permissions.ts",
    "seed:inbox": "tsx scripts/seed-inbox.ts",
    "seed:dashboard": "tsx scripts/seed-dashboard-data.ts",
    "seed:fee-config": "tsx scripts/seed-fee-config.ts",
    "db:sync": "tsx scripts/sync-db.ts",
    "db:wipe": "tsx scripts/wipe-all-data.ts"
  },
  "dependencies": {
    "@formulajs/formulajs": "^4.6.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "mysql2": "^3.14.0",
    "nodemailer": "^8.0.4",
    "resend": "^6.10.0",
    "sequelize": "^6.37.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
